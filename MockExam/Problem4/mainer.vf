`timescale 100 ps / 10 ps

module FJKCE_HXILINX_mainer(Q, C, CE, CLR, J, K);
   
   output             Q;

   input 	      C;	
   input 	      CE;	
   input 	      CLR;	
   input              J;
   input              K;
   
   parameter INIT = 1'b0;
   reg                Q = INIT;
   
   always @(posedge C or posedge CLR)
     begin
	if (CLR)
	  Q <= 1'b0;
	else if(CE)
        begin
          if(!J)
          begin
            if(K)
            Q <= 1'b0;
          end
          else
          begin
            if(!K)
            Q <= 1'b1;
            else 
            Q <= !Q;
          end
        end
     end
   
endmodule
`timescale 100 ps / 10 ps

module CB2RE_HXILINX_mainer(CEO, Q0, Q1, TC, C, CE, R);
   
   localparam TERMINAL_COUNT = 2'b11;
   
   output             CEO;
   output             Q0;
   output             Q1;
   output             TC;
   
   input 	      C;	
   input 	      CE;	
   input 	      R;	
   
   reg                Q0;
   reg                Q1;
   
   always @(posedge C)
     begin
	if (R)
	  {Q1, Q0} <= 2'b00;
	else if (CE)
	  {Q1,Q0} <= {Q1,Q0} + 1;
     end
   
   assign CEO = TC & CE;
   assign TC = ({Q1,Q0} == TERMINAL_COUNT); 
   
endmodule
`timescale  100 ps / 10 ps

module INV4_HXILINX_mainer (O0, O1, O2, O3, I0, I1, I2, I3);
    

   output O0;
   output O1;
   output O2;
   output O3;

   input  I0;
   input  I1;
   input  I2;
   input  I3;

assign O0 = !I0;
assign O1 = !I1;
assign O2 = !I2;
assign O3 = !I3;

endmodule
`timescale 100 ps / 10 ps

module FJKC_HXILINX_mainer(Q, C, CLR, J, K);
   
   output             Q;

   input 	      C;	
   input 	      CLR;	
   input              J;
   input              K;
   
   parameter INIT = 1'b0;
   reg                Q = INIT;


   always @(posedge C or posedge CLR)
     begin
	if (CLR)
	  Q <= 1'b0;
	else
        begin
           if(!J)
           begin
              if(K)
              Q <= 1'b0;
           end
           else
           begin
              if(!K)
              Q <= 1'b1;
              else 
              Q <= !Q;
           end
        end
     end
   
endmodule
`timescale  100 ps / 10 ps

module D2_4E_HXILINX_mainer (D0, D1, D2, D3, A0, A1, E);
    

   output D0;
   output D1;
   output D2;
   output D3;

   input  A0;
   input  A1;
   input  E;
  
   reg D0;
   reg D1;
   reg D2;
   reg D3;

      always @ (A0 or A1 or E)
      begin
         if(!E)
           {D3, D2, D1, D0} <= 4'b0000;
        else
        begin
           case({A1,A0})
             2'b00 : {D3,D2,D1,D0} <= 4'b0001;
             2'b01 : {D3,D2,D1,D0} <= 4'b0010;
             2'b10 : {D3,D2,D1,D0} <= 4'b0100;
             2'b11 : {D3,D2,D1,D0} <= 4'b1000;
          endcase
        end
     end 

endmodule
`timescale 1ns / 1ps

module btw4_MUSER_mainer(I, 
                         O0, 
                         O1, 
                         O2, 
                         O3);

    input [3:0] I;
   output O0;
   output O1;
   output O2;
   output O3;
   
   
   BUF  XLXI_1 (.I(I[0]), 
               .O(O0));
   BUF  XLXI_2 (.I(I[1]), 
               .O(O1));
   BUF  XLXI_3 (.I(I[2]), 
               .O(O2));
   BUF  XLXI_4 (.I(I[3]), 
               .O(O3));
endmodule
`timescale 1ns / 1ps

module wtb4_MUSER_mainer(I0, 
                         I1, 
                         I2, 
                         I3, 
                         O);

    input I0;
    input I1;
    input I2;
    input I3;
   output [3:0] O;
   
   
   BUF  XLXI_1 (.I(I0), 
               .O(O[0]));
   BUF  XLXI_2 (.I(I1), 
               .O(O[1]));
   BUF  XLXI_3 (.I(I2), 
               .O(O[2]));
   BUF  XLXI_4 (.I(I3), 
               .O(O[3]));
endmodule
`timescale 1ns / 1ps

module counter0_8_MUSER_mainer(CE, 
                               CLK, 
                               CLR, 
                               CEO, 
                               Q0, 
                               Q1, 
                               Q2, 
                               Q3, 
                               TC);

    input CE;
    input CLK;
    input CLR;
   output CEO;
   output Q0;
   output Q1;
   output Q2;
   output Q3;
   output TC;
   
   wire XLXN_1;
   wire XLXN_2;
   wire XLXN_3;
   wire XLXN_4;
   wire XLXN_5;
   wire XLXN_6;
   wire XLXN_7;
   wire XLXN_8;
   wire XLXN_9;
   wire Q0_DUMMY;
   wire Q1_DUMMY;
   wire Q2_DUMMY;
   wire Q3_DUMMY;
   wire TC_DUMMY;
   
   assign Q0 = Q0_DUMMY;
   assign Q1 = Q1_DUMMY;
   assign Q2 = Q2_DUMMY;
   assign Q3 = Q3_DUMMY;
   assign TC = TC_DUMMY;
   (* HU_SET = "FlipFlop_A_0" *) 
   FJKCE_HXILINX_mainer  FlipFlop_A (.C(CLK), 
                                    .CE(CE), 
                                    .CLR(CLR), 
                                    .J(XLXN_2), 
                                    .K(XLXN_1), 
                                    .Q(Q0_DUMMY));
   (* HU_SET = "FlipFlop_B_1" *) 
   FJKCE_HXILINX_mainer  FlipFlop_B (.C(CLK), 
                                    .CE(CE), 
                                    .CLR(CLR), 
                                    .J(Q0_DUMMY), 
                                    .K(Q0_DUMMY), 
                                    .Q(Q1_DUMMY));
   (* HU_SET = "FlipFlop_C_2" *) 
   FJKCE_HXILINX_mainer  FlipFlop_C (.C(CLK), 
                                    .CE(CE), 
                                    .CLR(CLR), 
                                    .J(XLXN_4), 
                                    .K(XLXN_3), 
                                    .Q(Q2_DUMMY));
   (* HU_SET = "FlipFlop_D_3" *) 
   FJKCE_HXILINX_mainer  FlipFlop_D (.C(CLK), 
                                    .CE(CE), 
                                    .CLR(CLR), 
                                    .J(XLXN_6), 
                                    .K(XLXN_5), 
                                    .Q(Q3_DUMMY));
   VCC  XLXI_1 (.P(XLXN_1));
   INV  XLXI_2 (.I(Q3_DUMMY), 
               .O(XLXN_2));
   AND2  XLXI_3 (.I0(Q0_DUMMY), 
                .I1(Q1_DUMMY), 
                .O(XLXN_3));
   AND2  XLXI_4 (.I0(Q0_DUMMY), 
                .I1(Q1_DUMMY), 
                .O(XLXN_4));
   VCC  XLXI_5 (.P(XLXN_5));
   AND3  XLXI_6 (.I0(Q0_DUMMY), 
                .I1(Q1_DUMMY), 
                .I2(Q2_DUMMY), 
                .O(XLXN_6));
   AND4  XLXI_7 (.I0(XLXN_7), 
                .I1(XLXN_8), 
                .I2(XLXN_9), 
                .I3(Q3_DUMMY), 
                .O(TC_DUMMY));
   INV  XLXI_8 (.I(Q0_DUMMY), 
               .O(XLXN_7));
   INV  XLXI_9 (.I(Q1_DUMMY), 
               .O(XLXN_8));
   INV  XLXI_10 (.I(Q2_DUMMY), 
                .O(XLXN_9));
   AND2  XLXI_11 (.I0(CE), 
                 .I1(TC_DUMMY), 
                 .O(CEO));
endmodule
`timescale 1ns / 1ps

module Displayer_MUSER_mainer(Blinker_Clock, 
                              Hour_Ones, 
                              Hour_Tens, 
                              Min_Ones, 
                              Min_Tens, 
                              Scan_Clock, 
                              Common, 
                              DP, 
                              Segment);

    input Blinker_Clock;
    input [3:0] Hour_Ones;
    input [3:0] Hour_Tens;
    input [3:0] Min_Ones;
    input [3:0] Min_Tens;
    input Scan_Clock;
   output [3:0] Common;
   output DP;
   output [6:0] Segment;
   
   wire XLXN_9;
   wire XLXN_17;
   wire [3:0] XLXN_23;
   wire XLXN_70;
   wire XLXN_71;
   wire XLXN_72;
   wire XLXN_76;
   wire XLXN_77;
   wire XLXN_78;
   wire XLXN_79;
   
   SSEG_DEC  XLXI_1 (.BCD(XLXN_23[3:0]), 
                    .SSEG(Segment[6:0]));
   (* HU_SET = "XLXI_2_6" *) 
   CB2RE_HXILINX_mainer  XLXI_2 (.C(Scan_Clock), 
                                .CE(XLXN_17), 
                                .R(XLXN_9), 
                                .CEO(), 
                                .Q0(XLXN_70), 
                                .Q1(XLXN_71), 
                                .TC());
   GND  XLXI_5 (.G(XLXN_9));
   VCC  XLXI_15 (.P(XLXN_17));
   Mux4_Bus4_1E  XLXI_16 (.D0(Min_Ones[3:0]), 
                         .D1(Min_Tens[3:0]), 
                         .D2(Hour_Ones[3:0]), 
                         .D3(Hour_Tens[3:0]), 
                         .E(XLXN_72), 
                         .S0(XLXN_70), 
                         .S1(XLXN_71), 
                         .O(XLXN_23[3:0]));
   AND3B1  XLXI_43 (.I0(XLXN_70), 
                   .I1(XLXN_71), 
                   .I2(Blinker_Clock), 
                   .O(DP));
   (* HU_SET = "XLXI_45_4" *) 
   D2_4E_HXILINX_mainer  XLXI_45 (.A0(XLXN_70), 
                                 .A1(XLXN_71), 
                                 .E(XLXN_72), 
                                 .D0(XLXN_79), 
                                 .D1(XLXN_78), 
                                 .D2(XLXN_77), 
                                 .D3(XLXN_76));
   VCC  XLXI_46 (.P(XLXN_72));
   (* HU_SET = "XLXI_47_5" *) 
   INV4_HXILINX_mainer  XLXI_47 (.I0(XLXN_76), 
                                .I1(XLXN_77), 
                                .I2(XLXN_78), 
                                .I3(XLXN_79), 
                                .O0(Common[3]), 
                                .O1(Common[2]), 
                                .O2(Common[1]), 
                                .O3(Common[0]));
endmodule
`timescale 1ns / 1ps

module ClockDiv10_MUSER_mainer(CLK, 
                               CLKO);

    input CLK;
   output CLKO;
   
   wire XLXN_18;
   wire XLXN_28;
   wire XLXN_29;
   wire XLXN_30;
   wire XLXN_33;
   wire XLXN_34;
   wire XLXN_35;
   wire XLXN_36;
   wire XLXN_38;
   wire XLXN_39;
   wire XLXN_123;
   wire CLKO_DUMMY;
   
   assign CLKO = CLKO_DUMMY;
   (* HU_SET = "XLXI_1_7" *) 
   FJKC_HXILINX_mainer  XLXI_1 (.C(CLK), 
                               .CLR(XLXN_18), 
                               .J(XLXN_35), 
                               .K(XLXN_36), 
                               .Q(XLXN_30));
   (* HU_SET = "XLXI_2_8" *) 
   FJKC_HXILINX_mainer  XLXI_2 (.C(CLK), 
                               .CLR(XLXN_18), 
                               .J(XLXN_30), 
                               .K(XLXN_34), 
                               .Q(XLXN_33));
   (* HU_SET = "XLXI_3_9" *) 
   FJKC_HXILINX_mainer  XLXI_3 (.C(CLK), 
                               .CLR(XLXN_18), 
                               .J(XLXN_29), 
                               .K(XLXN_28), 
                               .Q(XLXN_34));
   GND  XLXI_15 (.G(XLXN_18));
   VCC  XLXI_20 (.P(XLXN_28));
   INV  XLXI_21 (.I(XLXN_30), 
                .O(XLXN_29));
   AND2B1  XLXI_22 (.I0(XLXN_33), 
                   .I1(XLXN_34), 
                   .O(XLXN_35));
   VCC  XLXI_23 (.P(XLXN_36));
   FD_1 #( .INIT(1'b0) ) XLXI_24 (.C(CLK), 
                 .D(XLXN_33), 
                 .Q(XLXN_38));
   OR2  XLXI_25 (.I0(XLXN_38), 
                .I1(XLXN_33), 
                .O(XLXN_123));
   FD_1 #( .INIT(1'b0) ) XLXI_26 (.C(XLXN_123), 
                 .D(XLXN_39), 
                 .Q(CLKO_DUMMY));
   INV  XLXI_27 (.I(CLKO_DUMMY), 
                .O(XLXN_39));
endmodule
`timescale 1ns / 1ps

module clkdiv2_MUSER_mainer(CLK, 
                            CLKO);

    input CLK;
   output CLKO;
   
   wire XLXN_27;
   wire CLKO_DUMMY;
   
   assign CLKO = CLKO_DUMMY;
   FD_1 #( .INIT(1'b0) ) XLXI_17 (.C(CLK), 
                 .D(XLXN_27), 
                 .Q(CLKO_DUMMY));
   INV  XLXI_18 (.I(CLKO_DUMMY), 
                .O(XLXN_27));
endmodule
`timescale 1ns / 1ps

module mainer(OSC, 
              PB3_START, 
              PB4_RESET, 
              LED1, 
              SSD_COM, 
              SSD_DP, 
              SSD_Segment);

    input OSC;
    input PB3_START;
    input PB4_RESET;
   output LED1;
   output [3:0] SSD_COM;
   output SSD_DP;
   output [6:0] SSD_Segment;
   
   wire XLXN_29;
   wire XLXN_31;
   wire XLXN_42;
   wire [3:0] XLXN_101;
   wire XLXN_117;
   wire XLXN_10793;
   wire XLXN_10879;
   wire XLXN_10880;
   wire XLXN_10881;
   wire XLXN_10895;
   wire XLXN_10896;
   wire XLXN_10899;
   wire XLXN_10901;
   wire XLXN_10902;
   wire XLXN_10903;
   wire XLXN_10904;
   wire [3:0] XLXN_10911;
   wire [3:0] XLXN_10912;
   wire [3:0] XLXN_10913;
   wire XLXN_10914;
   wire [3:0] XLXN_10915;
   wire XLXN_10923;
   wire XLXN_10924;
   wire XLXN_10925;
   wire XLXN_10926;
   
   counter0_8_MUSER_mainer  XLXI_1 (.CE(XLXN_10880), 
                                   .CLK(XLXN_10895), 
                                   .CLR(XLXN_10896), 
                                   .CEO(XLXN_10899), 
                                   .Q0(XLXN_10923), 
                                   .Q1(XLXN_10924), 
                                   .Q2(XLXN_10925), 
                                   .Q3(XLXN_10926), 
                                   .TC());
   (* HU_SET = "XLXI_26_10" *) 
   FJKC_HXILINX_mainer  XLXI_26 (.C(PB3_START), 
                                .CLR(XLXN_31), 
                                .J(XLXN_29), 
                                .K(XLXN_29), 
                                .Q(XLXN_10880));
   VCC  XLXI_27 (.P(XLXN_29));
   GND  XLXI_28 (.G(XLXN_31));
   Displayer_MUSER_mainer  XLXI_43 (.Blinker_Clock(XLXN_10914), 
                                   .Hour_Ones(XLXN_10912[3:0]), 
                                   .Hour_Tens(XLXN_101[3:0]), 
                                   .Min_Ones(XLXN_10911[3:0]), 
                                   .Min_Tens(XLXN_10913[3:0]), 
                                   .Scan_Clock(XLXN_10881), 
                                   .Common(XLXN_10915[3:0]), 
                                   .DP(SSD_DP), 
                                   .Segment(SSD_Segment[6:0]));
   AND2B1  XLXI_44 (.I0(XLXN_10880), 
                   .I1(PB4_RESET), 
                   .O(XLXN_10896));
   clkdiv2_MUSER_mainer  XLXI_45 (.CLK(XLXN_10793), 
                                 .CLKO(XLXN_10895));
   ClockDiv10_MUSER_mainer  XLXI_46 (.CLK(XLXN_42), 
                                    .CLKO(XLXN_10793));
   ClockDiv1K  XLXI_47 (.CLK(XLXN_117), 
                       .CLK_O(XLXN_42));
   ClockDiv1K  XLXI_48 (.CLK(XLXN_10879), 
                       .CLK_O(XLXN_117));
   AND2  XLXI_65 (.I0(XLXN_10880), 
                 .I1(OSC), 
                 .O(XLXN_10879));
   ClockDiv1K  XLXI_66 (.CLK(OSC), 
                       .CLK_O(XLXN_10881));
   counter0_8_MUSER_mainer  XLXI_70 (.CE(XLXN_10899), 
                                    .CLK(XLXN_10895), 
                                    .CLR(XLXN_10896), 
                                    .CEO(), 
                                    .Q0(XLXN_10901), 
                                    .Q1(XLXN_10902), 
                                    .Q2(XLXN_10903), 
                                    .Q3(XLXN_10904), 
                                    .TC());
   wtb4_MUSER_mainer  XLXI_72 (.I0(XLXN_10901), 
                              .I1(XLXN_10902), 
                              .I2(XLXN_10903), 
                              .I3(XLXN_10904), 
                              .O(XLXN_101[3:0]));
   wtb4_MUSER_mainer  XLXI_73 (.I0(XLXN_10923), 
                              .I1(XLXN_10924), 
                              .I2(XLXN_10925), 
                              .I3(XLXN_10926), 
                              .O(XLXN_10911[3:0]));
   GND  XLXI_74_0 (.G(XLXN_10912[0]));
   GND  XLXI_74_1 (.G(XLXN_10912[1]));
   GND  XLXI_74_2 (.G(XLXN_10912[2]));
   GND  XLXI_74_3 (.G(XLXN_10912[3]));
   GND  XLXI_76 (.G(XLXN_10914));
   GND  XLXI_77_0 (.G(XLXN_10913[0]));
   GND  XLXI_77_1 (.G(XLXN_10913[1]));
   GND  XLXI_77_2 (.G(XLXN_10913[2]));
   GND  XLXI_77_3 (.G(XLXN_10913[3]));
   btw4_MUSER_mainer  XLXI_78 (.I(XLXN_10915[3:0]), 
                              .O0(SSD_COM[0]), 
                              .O1(), 
                              .O2(), 
                              .O3(SSD_COM[3]));
   VCC  XLXI_81 (.P(SSD_COM[1]));
   VCC  XLXI_82 (.P(SSD_COM[2]));
   AND4B1  XLXI_83 (.I0(XLXN_10926), 
                   .I1(XLXN_10925), 
                   .I2(XLXN_10924), 
                   .I3(XLXN_10923), 
                   .O(LED1));
endmodule
