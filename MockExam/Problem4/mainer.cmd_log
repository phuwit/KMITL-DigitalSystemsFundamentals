xst -intstyle ise -ifn "/home/phuwit/Programming/KMITL-DigitalSystemsFundamentals/MockExam/Problem4/mainer.xst" -ofn "/home/phuwit/Programming/KMITL-DigitalSystemsFundamentals/MockExam/Problem4/mainer.syr" 
ngdbuild -intstyle ise -dd _ngo -nt timestamp -uc mainer.ucf -p xc6slx9-tqg144-3 mainer.ngc mainer.ngd  
ngdbuild -intstyle ise -dd _ngo -nt timestamp -uc mainer.ucf -p xc6slx9-tqg144-3 mainer.ngc mainer.ngd  
map -intstyle ise -p xc6slx9-tqg144-3 -w -logic_opt off -ol high -t 1 -xt 0 -register_duplication off -r 4 -global_opt off -mt off -ir off -pr off -lc off -power off -o mainer_map.ncd mainer.ngd mainer.pcf 
par -w -intstyle ise -ol high -mt off mainer_map.ncd mainer.ncd mainer.pcf 
trce -intstyle ise -v 3 -s 3 -n 3 -fastpaths -xml mainer.twx mainer.ncd -o mainer.twr mainer.pcf -ucf mainer.ucf 
bitgen -intstyle ise -f mainer.ut mainer.ncd 
