                                   .D2(D2[6]), 
                                   .D3(D3[6]), 
                                   .E(XLXN_5), 
                                   .S0(S0), 
                                   .S1(S1), 
                                   .O(O[6]));
   (* HU_SET = "XLXI_8_48" *) 
   M4_1E_HXILINX_ssd4d_raw  XLXI_8 (.D0(D0[7]), 
                                   .D1(D1[7]), 
                                   .D2(D2[7]), 
                                   .D3(D3[7]), 
                                   .E(XLXN_5), 
                                   .S0(S0), 
                                   .S1(S1), 
                                   .O(O[7]));
   VCC  XLXI_9 (.P(XLXN_5));
