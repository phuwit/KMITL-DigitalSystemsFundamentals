`timescale 1ns / 1ps

module btw8_MUSER_ssd4d_raw(I, 
                            O0, 
                            O1, 
                            O2, 
                            O3, 
                            O4, 
                            O5, 
                            O6, 
                            O7);

    input [7:0] I;
   output O0;
   output O1;
   output O2;
   output O3;
   output O4;
   output O5;
   output O6;
   output O7;
   
   
   BUF  XLXI_1 (.I(I[0]), 
               .O(O0));
   BUF  XLXI_2 (.I(I[1]), 
               .O(O1));
   BUF  XLXI_3 (.I(I[2]), 
               .O(O2));
   BUF  XLXI_4 (.I(I[3]), 
               .O(O3));
   BUF  XLXI_5 (.I(I[4]), 
               .O(O4));
   BUF  XLXI_6 (.I(I[5]), 
               .O(O5));
   BUF  XLXI_7 (.I(I[6]), 
               .O(O6));
   BUF  XLXI_8 (.I(I[7]), 
               .O(O7));
endmodule
`timescale 1ns / 1ps

module ssd4d_raw(D0, 
                 D1, 
                 D2, 
                 D3, 
                 ScanCLK, 
                 COM, 
                 Segment);

    input [7:0] D0;
    input [7:0] D1;
    input [7:0] D2;
    input [7:0] D3;
    input ScanCLK;
   output [3:0] COM;
   output [7:0] Segment;
   
   wire XLXN_141;
   wire XLXN_146;
   wire XLXN_151;
   wire XLXN_236;
   wire XLXN_237;
   wire XLXN_238;
   wire XLXN_239;
   wire [7:0] XLXN_272;
   wire XLXN_276;
   wire XLXN_280;
   
   GND  XLXI_119 (.G(XLXN_141));
   (* HU_SET = "XLXI_162_50" *) 
   CB2CE_HXILINX_ssd4d_raw  XLXI_162 (.C(ScanCLK), 
                                     .CE(XLXN_146), 
                                     .CLR(XLXN_141), 
                                     .CEO(), 
                                     .Q0(XLXN_276), 
                                     .Q1(XLXN_280), 
                                     .TC());
   VCC  XLXI_163 (.P(XLXN_146));
   VCC  XLXI_165 (.P(XLXN_151));
   (* HU_SET = "XLXI_210_49" *) 
   D2_4E_HXILINX_ssd4d_raw  XLXI_210 (.A0(XLXN_276), 
                                     .A1(XLXN_280), 
                                     .E(XLXN_151), 
                                     .D0(XLXN_236), 
                                     .D1(XLXN_237), 
                                     .D2(XLXN_238), 
                                     .D3(XLXN_239));
   INV  XLXI_211 (.I(XLXN_236), 
                 .O(COM[0]));
   INV  XLXI_212 (.I(XLXN_237), 
                 .O(COM[1]));
   INV  XLXI_213 (.I(XLXN_238), 
                 .O(COM[2]));
   INV  XLXI_214 (.I(XLXN_239), 
                 .O(COM[3]));
   btw8_MUSER_ssd4d_raw  XLXI_216 (.I(XLXN_272[7:0]), 
                                  .O0(Segment[0]), 
                                  .O1(Segment[1]), 
                                  .O2(Segment[2]), 
                                  .O3(Segment[3]), 
                                  .O4(Segment[4]), 
                                  .O5(Segment[5]), 
                                  .O6(Segment[6]), 
                                  .O7(Segment[7]));
   mux4x1x8_MUSER_ssd4d_raw  XLXI_217 (.D0(D0[7:0]), 
                                      .D1(D1[7:0]), 
                                      .D2(D2[7:0]), 
                                      .D3(D3[7:0]), 
                                      .S0(XLXN_276), 
                                      .S1(XLXN_280), 
                                      .O(XLXN_272[7:0]));
endmodule
